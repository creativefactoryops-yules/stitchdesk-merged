# Copy this file to .env.local for local work. On Vercel, add the same names under
# Project > Settings > Environment Variables. Leave a line empty to switch that feature off.

# --- AI chat (required for Stitch to answer; without it Stitch says it is offline) ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Database, staff login and photo storage (optional) ---
# Leave all four empty to run in DEMO MODE (data saved only in the browser).
# Supabase > Project Settings > API. The VITE_ ones are read by the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Same two values again, for the /api functions on the server.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Before/after previews from a real photo (optional) ---
# Cloudflare dashboard > AI > Workers AI > "Use REST API". Without these, previews are made
# from a text description instead of the photo, and the app says so.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# --- Local testing only: point the chat at a fake Gemini server ---
# GEMINI_BASE_URL=http://localhost:9999/v1beta
