{
  "name": "stitch-voice-chat",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Stitch Voice Chat v2: AI reception, estimates, renders and job tracking for upholstery shops. By CreativeFactory.studio / buildyou.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx server/local-api.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:preview-file": "node scripts/build-preview-file.mjs",
    "test:smoke:api": "node tests/smoke/api-memory.mjs",
    "test:smoke:browser": "node tests/smoke/browser-smoke.mjs",
    "test:smoke:preview": "node tests/smoke/preview-smoke.mjs",
    "mock:gemini": "node tests/smoke/mock-gemini.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.10.2",
    "playwright": "^1.48.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.5"
  }
}
